# AI food recognition provider.
# Default provider is zhipu. Use aliyun only if you set AI_PROVIDER=aliyun.
AI_PROVIDER=zhipu

# Zhipu GLM-4V
ZHIPU_API_KEY=replace_with_your_zhipu_api_key
ZHIPU_MODEL=glm-4v-flash

# Aliyun DashScope Qwen VL
# AI_PROVIDER=aliyun
# DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
# DASHSCOPE_MODEL=qwen-vl-plus

# Local debug only. Do not enable in production.
# AI_MOCK=1
