   <string notr="true">QDialog {
    background-color: #0a0a0a;
}

#wdg_content {
    background-color: #000000;
    border: none;
    border-radius: 0px;
}

#wdg_midl, #wdg_buttom {
    background-color: transparent;
}

QLabel {
    color: #c8c8c8;
    font-family: &quot;Microsoft YaHei&quot;, &quot;SimHei&quot;, sans-serif;
    font-size: 12px;
    background: transparent;
    border: none;
}

/* ========== 进度条：灰色轨道 + 蓝色滑块 ========== */
QSlider::groove:horizontal {
    height: 3px;
    background: #555555;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background: #0ea5e9;
    border-radius: 1px;
}

QSlider::add-page:horizontal {
    background: #555555;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -3px 0;
    background: #0ea5e9;
    border-radius: 5px;
    border: 2px solid #0a0a0a;
}

QSlider::handle:horizontal:hover {
    background: #38bdf8;
    width: 12px;
    height: 12px;
    margin: -4px 0;
}

/* ========== 圆形符号按钮 ========== */
QPushButton {
    background-color: transparent;
    color: #e5e5e5;
    border: 2px solid #555555;
    border-radius: 16px;
    padding: 0px;
    font-size: 20px;
    font-weight: bold;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

QPushButton:hover {
    background-color: rgba(255,255,255,0.1);
    border-color: #0ea5e9;
    color: #0ea5e9;
}

QPushButton:pressed {
    background-color: rgba(14,165,233,0.2);
    border-color: #0ea5e9;
}

QPushButton:disabled {
    color: #444444;
    border-color: #333333;
}

/* 打开按钮：方形加粗样式 */
#pb_start {
    background-color: transparent;
    border: 2px solid #555555;
    border-radius: 4px;
    color: #e5e5e5;
    font-size: 22px;
    font-weight: bold;
    min-width: 32px;
    max-width: 32px;
    min-height: 28px;
    max-height: 28px;
}
#pb_start:hover {
    border-color: #0ea5e9;
    color: #0ea5e9;
}

/* 在线播放按钮 */
#pb_online {
    font-size: 24px;
    font-weight: bold;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 16px;
}</string>
